<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lets the in-app updater hand a downloaded APK to the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Car screen (MoonfinCarService): location is used only to tell when the
         car is moving so video can be paused; "display over other apps" lets
         the app move its own screen onto the car display. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>

    <!-- Android Auto parked apps (phone builds only). appCategory="video"
         tells the car host this is a video app, and CAR_LAUNCHER puts the
         full app in the Android Auto launcher so it can run on the car
         screen while parked. Android Auto hides the activity once the car
         starts moving; PlaybackLifecycleHandler pauses video when that
         happens on the car display. -->
    <application android:appCategory="video">
        <activity android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.CAR_LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Shows Moonfin-Auto's full screen, video player included, on the
             Android Auto display through Android Auto's unofficial projection
             API (the same one Fermata Auto uses). Needs "Unknown sources" on
             in Android Auto's developer settings. -->
        <service
            android:name="org.moonfin.androidtv.car.MoonfinCarService"
            android:exported="true"
            android:label="Moonfin-Auto Video">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="com.google.android.gms.car.category.CATEGORY_PROJECTION"/>
                <category android:name="com.google.android.gms.car.category.CATEGORY_PROJECTION_OEM"/>
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
    </application>
</manifest>
